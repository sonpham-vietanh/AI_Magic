# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit file .env.local.

# --- Supabase ---
# Thiếu cấu hình Supabase => các API lưu trữ trả lỗi rõ ràng (không dùng khóa mặc định).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng phía server. Không import lib/supabase.ts từ client component.
SUPABASE_SECRET_KEY=

# --- LLM (tùy chọn) ---
# Thiếu cấu hình LLM => engine tự động dùng mẫu (template) dựng sẵn.
# Endpoint tunnel yêu cầu stream:true (đã xử lý trong lib/engine/llmClient.ts).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Bảo mật API ---
# (Tùy chọn) Bearer token cho caller bên ngoài gọi các API nội bộ.
APP_API_TOKEN=
# (Bắt buộc cho GET /api/major-os/usage) Thiếu => endpoint trả 503.
MAJOR_OS_API_KEY=

# --- Đăng nhập Google Workspace (email trường) ---
# Có cả hai biến GOOGLE_* thì BẬT đăng nhập: mọi trang và API cần phiên; tên người soạn/duyệt lấy từ email.
# Bỏ trống thì giữ chế độ cũ (tự khai tên). Redirect URI cần khai trong Google Cloud:
#   <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Địa chỉ gốc công khai của ứng dụng (bắt buộc ở production), ví dụ https://magic.truongvietanh.com
APP_BASE_URL=
# Tên miền email được phép, phân cách bằng dấu phẩy (mặc định truongvietanh.com).
AUTH_ALLOWED_DOMAINS=truongvietanh.com
# Email được quyền Người duyệt, phân cách bằng dấu phẩy.
REVIEWER_EMAILS=
# Khóa ký phiên đăng nhập (chuỗi dài ngẫu nhiên). Thiếu ở production thì không ký được phiên.
SESSION_SECRET=

# Mã dùng chung của người duyệt (header x-reviewer-key). Vẫn dùng được làm cửa dự phòng khi cần. Thiếu => mọi thao tác duyệt/quản trị trả 503.
# Chưa phải đăng nhập thật; dùng chuỗi dài, ngẫu nhiên.
REVIEWER_KEY=
# Danh sách tên người duyệt đề kiểm tra, phân cách bằng dấu phẩy.
ASSESSMENT_REVIEWERS=

# --- Hạ tầng ---
# Số proxy tin cậy đứng trước app khi đọc x-forwarded-for cho giới hạn tốc độ (Cloudflare+Traefik: thường 1-2).
TRUSTED_PROXY_HOPS=1

# --- Dịch vụ ngoài (dự kiến, chưa tích hợp; chỉ để trang /ket-noi báo "đã cấu hình") ---
GAMMA_API_KEY=
CANVA_API_KEY=
GEMINI_NOTEBOOK_API_KEY=
TTS_API_KEY=
STT_API_KEY=

# --- Đường dẫn file dữ liệu (tuỳ chọn; mặc định nằm trong .data/ — gắn volume bền cho thư mục này) ---
ASSESSMENT_STORE_FILE=
KHO_ASSETS_FILE=
KHO_REVIEWS_FILE=
EVAL_FILE=
SIGNALS_FILE=
TEACHER_SESSION_STORE_PATH=
USER_ROLES_STORE_PATH=
USER_PREFS_FILE=
USAGE_LEDGER_FILE=
AUDIT_LOG_STORE_PATH=
OPS_LOG_FILE=

# --- Quản trị, hạn mức và chi phí AI ---
# Email quản trị viên (vào /quan-tri/**), phân cách bằng dấu phẩy. Có thể gán thêm ở trang quản trị.
ADMIN_EMAILS=
# Trần số lượt soạn bằng AI mỗi người mỗi ngày. Mặc định 0 = KHÔNG giới hạn. Đặt số (ví dụ 40) nếu cần kiểm soát chi phí.
USAGE_DAILY_LIMIT=
# Ngân sách tháng ước tính (USD), chỉ cảnh báo, không chặn. Trống hoặc 0 = không đặt.
USAGE_MONTHLY_BUDGET_USD=
# Ghi đè bảng giá tham khảo (USD mỗi triệu token), ví dụ: {"ten-mo-hinh":{"in":1,"out":4}}
USAGE_PRICING_JSON=

# --- Nhiều khóa AI để xoay vòng (tùy chọn, phân cách bằng dấu phẩy) và nhà cung cấp bổ sung ---
GEMINI_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_BASE_URL=
GROQ_MODEL=
OPENAI_API_KEYS=
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=
# 1 = ép gọi AI cho gói tài nguyên thay vì dựng mẫu.
FORCE_LLM_ON_PACK=

# --- Supabase: nâng cao ---
# Tên bảng lưu kho vận hành (mặc định va_app_store; xem supabase/migrations).
SUPABASE_APP_STORE_TABLE=
# 1 = bật đồng bộ Supabase ngoài production (máy dev dùng chung .env.local nên mặc định TẮT; chỉ bật có chủ đích).
VA_CLOUD_STORE=

# --- Kiểm thử (không đặt trên máy chủ) ---
# Địa chỉ bản đang chạy cho npm run test:smoke.
SMOKE_BASE_URL=
