# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit file .env.local.

# --- Supabase ---
# Thiếu cấu hình Supabase => các API lưu trữ trả lỗi rõ ràng (không dùng khóa mặc định).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng phía server. Không import lib/supabase.ts từ client component.
SUPABASE_SECRET_KEY=

# --- LLM (tùy chọn) ---
# Thiếu cấu hình LLM => engine tự động dùng mẫu (template) dựng sẵn.
# Endpoint tunnel yêu cầu stream:true (đã xử lý trong lib/engine/llmClient.ts).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Bảo mật API ---
# (Tùy chọn) Bearer token cho caller bên ngoài gọi các API nội bộ.
APP_API_TOKEN=
# (Bắt buộc cho GET /api/major-os/usage) Thiếu => endpoint trả 503.
MAJOR_OS_API_KEY=

# Mã dùng chung của người duyệt (header x-reviewer-key). Thiếu => mọi thao tác duyệt/quản trị trả 503.
# Chưa phải đăng nhập thật; dùng chuỗi dài, ngẫu nhiên.
REVIEWER_KEY=
# Danh sách tên người duyệt đề kiểm tra, phân cách bằng dấu phẩy.
ASSESSMENT_REVIEWERS=

# --- Hạ tầng ---
# Số proxy tin cậy đứng trước app khi đọc x-forwarded-for cho giới hạn tốc độ (Cloudflare+Traefik: thường 1-2).
TRUSTED_PROXY_HOPS=1

# --- Dịch vụ ngoài (dự kiến, chưa tích hợp; chỉ để trang /ket-noi báo "đã cấu hình") ---
GAMMA_API_KEY=
CANVA_API_KEY=
GEMINI_NOTEBOOK_API_KEY=
TTS_API_KEY=
STT_API_KEY=

# --- Đường dẫn file dữ liệu (tuỳ chọn; mặc định nằm trong .data/ — gắn volume bền cho thư mục này) ---
ASSESSMENT_STORE_FILE=
KHO_ASSETS_FILE=
KHO_REVIEWS_FILE=
EVAL_FILE=
SIGNALS_FILE=
